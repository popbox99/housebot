# Environment for live/signal-llm-bot.py (the deployed bot).
# Copy to a private location (NOT into this repo), fill in, and load it from
# your service manager (launchd EnvironmentVariables, systemd EnvironmentFile).
# Leave a value empty to disable that feature.

# --- Signal (required) ---
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_NUMBERS=
SIGNAL_SENDER_NAMES=
SIGNAL_ALERT_RECIPIENT=

# --- HTTP API for Home Assistant (required for the API; empty = every request rejected) ---
HOUSE_API_TOKEN=

# --- Home Assistant ---
HA_TOKEN=
HA_STORE_WATCH_ENTITY=
HA_VACUUM_ENTITY=
HA_VACUUM_BATTERY_ENTITY=

# --- CalDAV (Radicale on 127.0.0.1:5232) ---
CALDAV_USER=
CALDAV_PASSWORD=

# --- Paperless-ngx / Immich ---
PAPERLESS_TOKEN=
IMMICH_API_KEY=

# --- ntfy alerts ---
NTFY_URL=
NTFY_TOKEN=

# --- LLM backends (used only when ~/.local/share/house/llm_backends.conf is missing) ---
LLM_PRIMARY_URL=
LLM_PRIMARY_MODEL=
LLM_PRIMARY_NAME=
LLM_PRIMARY_PRESENCE=
LLM_FALLBACK_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_NAME=
LLM_FALLBACK_PRESENCE=

# --- Other services on the tailnet / LAN ---
WHISPER_URLS=
EMBED_URL=
PHOTO_SEARCH_URL=
SYNCTHING_PHONE_DEVICE_ID=
HOUSE_CONTACTS_JSON=
